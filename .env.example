# ==============================================================================
# SIWES DEVELOPER PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# - Never commit .env.local or production secrets to Git.
# - NEXT_PUBLIC_* variables are exposed to the browser.
# - Variables without NEXT_PUBLIC_ are strictly server-only secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Location: Supabase Dashboard -> Project Settings -> API (or database.new)
#
# Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable Key / Anon Key (Public)
# Used by both browser client and server-side SSR client
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (Optional / Server-Only)
# Used only by backend seed/verification scripts (scripts/seed-db.js) if bypassing RLS
# WARNING: NEVER expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHORIZATION (Required for Admin Access)
# ------------------------------------------------------------------------------
# Single-owner authorization email (Server-Only).
# Must match the exact email address of the developer account registered in
# Supabase Dashboard -> Authentication -> Users.
ADMIN_EMAIL=developer@example.com

# ------------------------------------------------------------------------------
# 3. CONTACT FORM & EMAIL DELIVERY (Resend Provider)
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys (Server-Only)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address (Server-Only)
# For testing: "Portfolio Contact <onboarding@resend.dev>"
# For production: "Your Name <contact@yourcustomdomain.com>"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Destination Inbox Address (Server-Only)
# The inbox where visitor messages will be delivered (defaults to ADMIN_EMAIL if omitted)
CONTACT_TO_EMAIL=developer@example.com

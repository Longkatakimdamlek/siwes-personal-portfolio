# ==============================================================================
# SIWES Portfolio Website - Local Environment Configuration Template
# Copy this file to .env.local and populate with your actual keys.
# NEVER commit .env.local with real secrets to version control.
# ==============================================================================

# Supabase PostgreSQL Database Configuration
# Obtain from your Supabase Project Settings -> API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public/Publishable Key (Also known as anon key in Supabase)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Module 4: Administrator Authorization (Single-Owner Portfolio)
# Enter the developer/owner email address created in Supabase Auth.
ADMIN_EMAIL=developer@example.com

# Module 6: Contact System & Email Delivery (Resend)
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key under API Keys: https://resend.com/api-keys
# 3. Paste the key below (starts with "re_"):
RESEND_API_KEY=re_your_resend_api_key

# Sender Address:
# In test mode without custom domain, use: "Portfolio Contact <onboarding@resend.dev>"
# Once custom domain is added in Resend, use: "Portfolio Contact <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Recipient Address:
# The inbox where contact messages should be delivered.
# (If not specified, falls back to the contact_email configured in Site Settings or ADMIN_EMAIL)
CONTACT_TO_EMAIL=developer@example.com
